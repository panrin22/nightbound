{
  "name": "nightbound-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nightbound AI story API (SpaceXAI / xAI)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "start:tsx": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "deploy:local-check": "npm run build && node -e \"console.log('build ok')\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "openai": "^6.15.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
