# Provider: auto | xai | groq
# auto = detect from key (gsk_ → groq, xai- → xai)
AI_PROVIDER=auto

# --- Option A: xAI / SpaceXAI (preferred long-term) ---
# https://console.x.ai
XAI_API_KEY=xai-your-key-here
XAI_MODEL=grok-4.5

# --- Option B: Groq (works with gsk_ keys) ---
# https://console.groq.com
# You can put gsk_ in either GROQ_API_KEY or XAI_API_KEY (auto-detect)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server
PORT=8787
HOST=0.0.0.0

# Optional shared secret for deploys
API_SECRET=
